# Copy this file to keystore.properties. The copy is ignored by Git.
# Keep the key and both passwords in a password manager and an offline backup.
storeFile=/absolute/path/to/vitalbreathe-release.p12
storePassword=YOUR_STORE_PASSWORD
keyAlias=vitalbreathe
# PKCS12 uses the store password for the key as well.
keyPassword=YOUR_STORE_PASSWORD
